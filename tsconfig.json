{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS", 
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "declaration": false,
    "removeComments": true
  },
  "include": ["src/**/*", "../app-soccer-core/enums"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}